{
  "name": "antaris-digital-twin",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "Dashboard"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w Dashboard\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w Dashboard",
    "build": "npm run build -w backend && npm run build -w Dashboard",
    "start": "npm run start -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
